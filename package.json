  },
  "homepage": "https://github.com/almero-digital-marketing/mikser-io-forms#readme",
  "peerDependencies": {
    "mikser-io": "^9.0.0"
  },
  "dependencies": {
    "multer": "^2.0.0",
    "yaml": "^2.9.0"
  },
